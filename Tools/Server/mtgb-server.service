[Unit]
Description=MTGB dedicated game server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=mtgb
Group=mtgb
UMask=0077
WorkingDirectory=/opt/mtgb/current
Environment=HOME=/var/lib/mtgb
Environment=XDG_CONFIG_HOME=/var/lib/mtgb/.config
Environment="JAVA_TOOL_OPTIONS=-Xms32m -Xmx384m -XX:ActiveProcessorCount=2 -XX:TieredStopAtLevel=1"
ExecStart=/opt/mtgb/current/MTGBServer -batchmode -nographics -mtgb-server -port 2323 -max-matches 1 -logFile -
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
MemoryHigh=750M
MemoryMax=900M
MemorySwapMax=256M
CPUQuota=125%
OOMScoreAdjust=500
TasksMax=256
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mtgb /var/log/mtgb
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
