# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Generated Unity data
Assets/Unity.VisualScripting.Generated/
Assets/Unity.VisualScripting.Generated.meta
# StreamingAssets contains required translations, search indexes and formats.
# Keep it in version control; generated Forge runtime stays outside Assets.
Assets/TutorialInfo/
Assets/TutorialInfo.meta
Assets/Readme.asset
Assets/Readme.asset.meta

# IDE and local tooling
.vs/
.idea/
.vscode/
.vsconfig
.agents/
.claude/
.codex/
.tools/
ForgeRuntime/
# Local card image packs and their download manifests; keep only setup notes.
/CardImages/**
!/CardImages/README.txt
__pycache__/
.trae/
*.csproj
*.sln
*.user
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# SQLite transient files
*.mtgbdb-journal
*.mtgbdb-shm
*.mtgbdb-wal

# Local replay recordings and optional video encoder binaries
/Replays/*.mtgbr
/Replays/Videos/
/VideoTools/*.exe
