# Preserve the exact bytes of the published, hashed native source snapshot.
/ThirdParty/Forge/native-patches/** -text
# Preserve font/license bytes pinned by open-fonts.json across Windows checkouts.
/Assets/Resources/UI/CardTemplates/Fonts/*.otf -text
/Assets/Resources/UI/CardTemplates/Fonts/*.ttf -text
/Assets/Resources/UI/CardTemplates/Fonts/*-OFL.txt -text whitespace=-blank-at-eol,cr-at-eol
/Assets/Resources/UI/CardTemplates/Fonts/ARPHICPL.TXT -text whitespace=-blank-at-eol,cr-at-eol
/Assets/Resources/UI/CardTemplates/Fonts/open-fonts.json -text whitespace=cr-at-eol
# Unity writes blank importer fields with a trailing space.
/Assets/Resources/UI/CardTemplates/Fonts/*.meta whitespace=-blank-at-eol
/Assets/Scripts/Editor/OpenFontPresentationValidation.cs.meta whitespace=-blank-at-eol
